// The teacher dashboard Worker, protected by Cloudflare Access.
// Uses the SAME database as the bot (same database_id).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classbot-admin",
  "main": "src/admin/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // the dashboard files; the Worker checks the login before serving them
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "classbot-db",
      "database_id": "ebd8fce7-7393-403c-a38b-f6edbb5dbc94",
      "migrations_dir": "migrations"
    }
  ],

  "ai": { "binding": "AI" },

  "vars": {
    "DISCORD_APP_ID": "1557727693561266187",
    "PUBLIC_URL": "https://classbot.abdeladim-abid.workers.dev",
    "AI_DAILY_LIMIT": "60",
    // filled in at step 9 (Cloudflare Access). Until then the dashboard stays locked.
    "TEAM_DOMAIN": "",
    "POLICY_AUD": ""
  }
  // secret (not in this file): DISCORD_TOKEN → npx wrangler secret put DISCORD_TOKEN -c wrangler.admin.jsonc
}
