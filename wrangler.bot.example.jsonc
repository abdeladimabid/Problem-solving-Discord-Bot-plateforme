// EXAMPLE. Your own settings are in wrangler.bot.jsonc (made from this file by `npm run setup`, or copy it
// yourself). That file is yours: it isn't in git, so `git pull` never changes it and each teacher deploys to
// their own Cloudflare account. When this example gets a new setting, `npm run update` tells you.
// The public bot Worker: Discord interactions, cron jobs, race replays.
// Fill in the 4 values marked PASTE (see README, steps 3–5).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classbot",
  "main": "src/bot/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // runs every minute: contests, duel timeouts, reminders, daily challenge, weekly recap
  "triggers": { "crons": ["* * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "classbot-db",
      "database_id": "PASTE_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "ai": { "binding": "AI" },

  "vars": {
    "DISCORD_APP_ID": "PASTE_DISCORD_APP_ID",
    "DISCORD_PUBLIC_KEY": "PASTE_DISCORD_PUBLIC_KEY",
    "PUBLIC_URL": "https://classbot.YOUR-SUBDOMAIN.workers.dev",
    "DASHBOARD_URL": "https://classbot-admin.YOUR-SUBDOMAIN.workers.dev",
    // max new AI challenges per day (free tier: 10,000 neurons ≈ 80 checked challenges)
    "AI_DAILY_LIMIT": "60"
  }
  // secret (not in this file): DISCORD_TOKEN → npx wrangler secret put DISCORD_TOKEN -c wrangler.bot.jsonc
}
