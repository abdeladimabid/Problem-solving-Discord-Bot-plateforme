{"nodes": [{"id": "docs_activities_templates_veille_live_coding_dwwm_2026_2027_doc", "label": "Templates: Veille, Live Coding & Workshop (DWWM 2026-2027)", "file_type": "document", "source_file": "docs/activities/TEMPLATES_VEILLE_LIVE_CODING_DWWM_2026-2027.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_activities_templates_veille_live_coding_dwwm_2026_2027_veille_template", "label": "Veille template", "file_type": "rationale", "rationale": "Shaped to fit a 30-minute learner presentation: 3-5 objectives, a 2-3 part plan, 2-3 reflection questions, and French-first resources (MDN fr, JavaScript.info fr) so links stay real and beginner-appropriate.", "source_file": "docs/activities/TEMPLATES_VEILLE_LIVE_CODING_DWWM_2026-2027.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_activities_templates_veille_live_coding_dwwm_2026_2027_live_coding_template", "label": "Live coding template", "file_type": "rationale", "rationale": "Deliberately small (app.js ~40-60 lines, at most 2 named functions, a 5-step d\u00e9roul\u00e9 totaling exactly 45 minutes) because the trainer is at the keyboard while beginner learners code in parallel; anything harder is pushed to an optional 'si le temps le permet' section.", "source_file": "docs/activities/TEMPLATES_VEILLE_LIVE_CODING_DWWM_2026-2027.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_activities_templates_veille_live_coding_dwwm_2026_2027_workshop_template", "label": "Workshop template", "file_type": "rationale", "rationale": "An extra activity for days without a live coding; learners work in groups of 2-3 while the trainer circulates, which is why the format allows more time (45-60 min) and more d\u00e9roul\u00e9 steps (4-6) than a live coding.", "source_file": "docs/activities/TEMPLATES_VEILLE_LIVE_CODING_DWWM_2026-2027.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_activities_templates_veille_live_coding_dwwm_2026_2027_weekly_planning_rules", "label": "Weekly planning rules (one veille/day, two live codings/week)", "file_type": "rationale", "rationale": "Veille order follows the week's concept dependencies, never requires a concept from a later programme week, and the week's last day is deliberately a lighter consolidation topic because that day's work is handed in.", "source_file": "docs/activities/TEMPLATES_VEILLE_LIVE_CODING_DWWM_2026-2027.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_activities_templates_veille_live_coding_dwwm_2026_2027_doc", "target": "docs_activities_templates_veille_live_coding_dwwm_2026_2027_veille_template", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/activities/TEMPLATES_VEILLE_LIVE_CODING_DWWM_2026-2027.md", "source_location": null, "weight": 1.0}, {"source": "docs_activities_templates_veille_live_coding_dwwm_2026_2027_doc", "target": "docs_activities_templates_veille_live_coding_dwwm_2026_2027_live_coding_template", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/activities/TEMPLATES_VEILLE_LIVE_CODING_DWWM_2026-2027.md", "source_location": null, "weight": 1.0}, {"source": "docs_activities_templates_veille_live_coding_dwwm_2026_2027_doc", "target": "docs_activities_templates_veille_live_coding_dwwm_2026_2027_workshop_template", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/activities/TEMPLATES_VEILLE_LIVE_CODING_DWWM_2026-2027.md", "source_location": null, "weight": 1.0}, {"source": "docs_activities_templates_veille_live_coding_dwwm_2026_2027_doc", "target": "docs_activities_templates_veille_live_coding_dwwm_2026_2027_weekly_pla